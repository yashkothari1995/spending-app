        "paidBy": { "type": "string" },
        "createdByUserId": { "type": "string" }
      },
      "required": ["id", "title", "amount", "frequency", "categoryId", "createdByUserId"]
    },
    "settlements": {
      "title": "Settlements",
      "description": "Recorded debt settlements between partners",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
