{
  "entities": {
    "userAccounts": {
      "title": "User Accounts",
      "description": "User accounts and profile metadata bound to authenticated Firebase Auth UID",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "avatarColor": { "type": "string" },
        "hasPartner": { "type": "boolean" },
        "partnerName": { "type": "string" },
        "partnerUserId": { "type": "string" },
        "currency": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "expenses": {
      "title": "Expenses",
      "description": "User-scoped transaction records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "totalAmount": { "type": "number" },
        "date": { "type": "string" },
        "categoryId": { "type": "string" },
        "paidBy": { "type": "string" },
        "splitType": { "type": "string" },
