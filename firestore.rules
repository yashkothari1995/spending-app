rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // User Accounts - strictly accessible only by document owner or linked partner
    match /userAccounts/{userId} {
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (resource != null && resource.data.partnerUserId == request.auth.uid)
      );
    }

    // Expenses - user data isolation based on authenticated UID
    match /expenses/{expenseId} {
      allow create: if request.auth != null && request.resource.data.createdByUserId == request.auth.uid;
      allow read, update, delete: if request.auth != null && (
        resource.data.createdByUserId == request.auth.uid ||
        (resource.data.keys().hasAll(['partnerUserId']) && resource.data.partnerUserId == request.auth.uid)
      );
    }

    // Recurring Expenses
    match /recurringExpenses/{recId} {
      allow create: if request.auth != null && request.resource.data.createdByUserId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.createdByUserId == request.auth.uid;
    }

    // Settlements
    match /settlements/{settleId} {
      allow create: if request.auth != null && request.resource.data.createdByUserId == request.auth.uid;
      allow read, update, delete: if request.auth != null && (
        resource.data.createdByUserId == request.auth.uid ||
        resource.data.payer == request.auth.uid ||
        resource.data.payee == request.auth.uid
      );
    }

    // Categories
    match /categories/{catId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.createdByUserId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.createdByUserId == request.auth.uid;
    }

    // Budgets
    match /budgets/{budgetId} {
      allow create, update, delete: if request.auth != null && (
        budgetId == request.auth.uid ||
        request.resource.data.createdByUserId == request.auth.uid
      );
      allow read: if request.auth != null && (
        budgetId == request.auth.uid ||
        (resource != null && resource.data.createdByUserId == request.auth.uid)
      );
    }
  }
}
